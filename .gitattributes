<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Saudagar Invest - Website Saham</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #07130f;
            color: white;
        }

        /* =========================
           NAVBAR
        ========================== */

        nav {
            height: 75px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 7%;
            background: #0c1d17;
            border-bottom: 1px solid #1c3d31;
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #39e58c;
        }

        .logo span {
            color: white;
        }

        .menu {
            display: flex;
            gap: 30px;
        }

        .menu a {
            text-decoration: none;
            color: #b8c9c1;
            font-size: 15px;
            transition: 0.3s;
        }

        .menu a:hover {
            color: #39e58c;
        }

        .login-btn {
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            background: #39e58c;
            color: #04100b;
            font-weight: bold;
            cursor: pointer;
        }

        /* =========================
           HERO
        ========================== */

        .hero {
            padding: 70px 7%;
            display: grid;
            grid-template-columns: 1.4fr 1fr;
            gap: 40px;
            align-items: center;

            background:
                radial-gradient(
                    circle at 80% 20%,
                    rgba(57, 229, 140, 0.18),
                    transparent 35%
                );
        }

        .hero h1 {
            font-size: 56px;
            line-height: 1.1;
            margin-bottom: 20px;
        }

        .hero h1 span {
            color: #39e58c;
        }

        .hero p {
            color: #9fb3aa;
            line-height: 1.7;
            max-width: 650px;
            margin-bottom: 30px;
        }

        .hero-btn {
            padding: 15px 25px;
            background: #39e58c;
            color: #05130d;
            border: none;
            border-radius: 10px;
            font-weight: bold;
            cursor: pointer;
            margin-right: 10px;
        }

        .hero-btn-outline {
            padding: 14px 25px;
            background: transparent;
            color: white;
            border: 1px solid #315648;
            border-radius: 10px;
            cursor: pointer;
        }

        /* =========================
           HERO MARKET CARD
        ========================== */

        .market-box {
            background: rgba(14, 34, 27, 0.9);
            border: 1px solid #1c4938;
            padding: 25px;
            border-radius: 18px;
        }

        .market-box h3 {
            margin-bottom: 20px;
        }

        .ihsg {
            font-size: 38px;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .green {
            color: #39e58c;
        }

        .red {
            color: #ff6666;
        }

        .chart {
            height: 160px;
            margin-top: 25px;
            display: flex;
            align-items: flex-end;
            gap: 8px;
        }

        .bar {
            flex: 1;
            border-radius: 5px 5px 0 0;
            background: linear-gradient(
                to top,
                #0f7045,
                #39e58c
            );
        }

        /* =========================
           MAIN CONTAINER
        ========================== */

        .container {
            width: 86%;
            margin: auto;
            padding-bottom: 80px;
        }

        .section-title {
            margin-top: 50px;
            margin-bottom: 20px;
        }

        .section-title p {
            color: #83998f;
            margin-top: 7px;
        }

        /* =========================
           SUMMARY CARDS
        ========================== */

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
        }

        .summary-card {
            background: #0d2119;
            border: 1px solid #1c4032;
            border-radius: 15px;
            padding: 20px;
        }

        .summary-card p {
            color: #8da298;
            font-size: 14px;
            margin-bottom: 12px;
        }

        .summary-card h2 {
            font-size: 24px;
        }

        /* =========================
           STOCK AREA
        ========================== */

        .stock-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .search-box {
            background: #0d2119;
            border: 1px solid #244d3c;
            border-radius: 10px;
            padding: 12px 15px;
            color: white;
            outline: none;
            width: 280px;
        }

        /* =========================
           TABLE
        ========================== */

        .table-wrapper {
            overflow-x: auto;
            border-radius: 15px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #0d2119;
            min-width: 750px;
        }

        th {
            color: #849a90;
            font-weight: normal;
            font-size: 14px;
            background: #10281f;
        }

        th,
        td {
            text-align: left;
            padding: 18px;
            border-bottom: 1px solid #19392c;
        }

        tr {
            transition: 0.25s;
        }

        tbody tr:hover {
            background: #123026;
        }

        .stock-code {
            font-weight: bold;
            color: white;
        }

        .stock-name {
            font-size: 13px;
            color: #81968c;
            margin-top: 4px;
        }

        .watch-btn {
            border: 1px solid #39e58c;
            background: transparent;
            color: #39e58c;
            padding: 8px 12px;
            border-radius: 7px;
            cursor: pointer;
        }

        .watch-btn.active {
            background: #39e58c;
            color: #05130d;
        }

        /* =========================
           NEWS
        ========================== */

        .news-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .news-card {
            background: #0d2119;
            border: 1px solid #1c4032;
            border-radius: 15px;
            padding: 22px;
        }

        .news-category {
            display: inline-block;
            font-size: 12px;
            color: #39e58c;
            margin-bottom: 15px;
        }

        .news-card h3 {
            line-height: 1.5;
            margin-bottom: 10px;
        }

        .news-card p {
            color: #84998f;
            font-size: 14px;
            line-height: 1.6;
        }

        /* =========================
           FOOTER
        ========================== */

        footer {
            background: #081710;
            padding: 40px 7%;
            border-top: 1px solid #19382c;
            display: flex;
            justify-content: space-between;
            color: #7b9187;
        }

        /* =========================
           RESPONSIVE
        ========================== */

        @media (max-width: 900px) {

            .menu {
                display: none;
            }

            .hero {
                grid-template-columns: 1fr;
            }

            .hero h1 {
                font-size: 42px;
            }

            .summary-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .news-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 600px) {

            nav,
            .hero {
                padding-left: 5%;
                padding-right: 5%;
            }

            .hero h1 {
                font-size: 36px;
            }

            .container {
                width: 90%;
            }

            .summary-grid {
                grid-template-columns: 1fr;
            }

            .stock-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .search-box {
                width: 100%;
            }

            footer {
                flex-direction: column;
                gap: 10px;
            }
        }
    </style>
</head>

