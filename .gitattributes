    <!-- =========================
         JAVASCRIPT
    ========================== -->

    <script>

        // Tombol menuju market
        function scrollMarket() {

            document
                .getElementById("market")
                .scrollIntoView({
                    behavior: "smooth"
                });

        }


        // Pencarian saham
        function searchStock() {

            const input =
                document
                .getElementById("searchInput")
                .value
                .toUpperCase();

            const table =
                document.getElementById("stockTable");

            const rows =
                table
                .getElementsByTagName("tbody")[0]
                .getElementsByTagName("tr");


            for (let i = 0; i < rows.length; i++) {

                const text =
                    rows[i]
                        .innerText
                        .toUpperCase();

                if (text.includes(input)) {

                    rows[i].style.display = "";

                } else {

                    rows[i].style.display = "none";

                }

            }

        }


        // Watchlist
        function toggleWatchlist(button, stock) {

            if (
                button.classList.contains("active")
            ) {

                button.classList.remove("active");

                button.innerHTML =
                    "+ Watchlist";

            } else {

                button.classList.add("active");

                button.innerHTML =
                    "✓ Dipantau";

                alert(
                    stock +
                    " berhasil ditambahkan ke watchlist!"
                );

            }

        }


        // Simulasi tombol masuk
        function login() {

            alert(
                "Fitur login akan dibuat pada tahap berikutnya."
            );

        }

    </script>

